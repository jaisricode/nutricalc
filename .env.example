# ===================================================
# NutriCalc Environment Configuration
# ===================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Obtain from your MongoDB Atlas Dashboard -> Connect -> Drivers -> Node.js
# Example format:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/nutricalc?retryWrites=true&w=majority&appName=NutriCalcCluster

# Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
